# ===========================
# Firebase Web Configuration (SAFE - Use for development & production)
# Get these from: Firebase Console > Project Settings > Your apps > Web
# ===========================
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY_HERE
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID_HERE
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID_HERE
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID_HERE

# ===========================
# Local Development Only - Emulator Hosts
# NEVER set these in production - always connect to cloud Firebase
# ===========================
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ===========================
# GitHub API Access (SENSITIVE - Server-side only)
# Get from: GitHub > Settings > Developer settings > Personal access tokens
# Requires: repo (full control of private repositories)
# WARNING: This token can write to repositories - NEVER expose in client code
# ===========================
GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE

# ===========================
# Firebase Admin SDK (SENSITIVE - Server-side only)
# Path to service account key JSON file, OR the actual service account JSON string
# Get from: Firebase Console > Project Settings > Service Accounts
# CRITICAL: Store the actual JSON file OUTSIDE the repo
# Only reference it via this path variable
# Alternatively, set FIREBASE_SERVICE_ACCOUNT_JSON to the stringified JSON content (recommended for Vercel)
# ===========================
GOOGLE_APPLICATION_CREDENTIALS=./scripts/iist-manufacturing-profile-firebase-adminsdk-fbsvc-aef84e7a4a.json
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ===========================
# GitHub Repository Configuration
# Used for resume storage and data management
# ===========================
GITHUB_REPO=Pranay1004/iistmanufacturing
GITHUB_OWNER=Pranay1004
GITHUB_REPO_NAME=iistmanufacturing

# ===========================
# Application Configuration
# ===========================
NEXT_PUBLIC_SITE_NAME=IIST Manufacturing Technology
NEXT_PUBLIC_SITE_URL=https://manufacturing.iist.ac.in
NEXT_PUBLIC_CONTACT_EMAIL=contact@iist.ac.in

# ===========================
# Security & Rate Limiting
# ===========================
# RATE_LIMIT_PER_MINUTE=30
# SESSION_TIMEOUT_MINUTES=30
# PASSWORD_RESET_TIMEOUT_MINUTES=15

# ===========================
# Development Mode Flags
# ===========================
NODE_ENV=development
NEXT_PUBLIC_DEBUG=false
